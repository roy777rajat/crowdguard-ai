# Copy to .env (git-ignored) and edit. Placeholders only: never commit real values.
# The app runs fine with none of these set (local template provider, no outside calls).

CROWDGUARD_DB=data/crowdguard.db
CROWDGUARD_CORS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional: use the real Meta Model API for AI explanations --------------------------------
# Real calls are sent ONLY when CROWDGUARD_PROVIDER=meta AND a credential below is set.
# What is sent: a short instruction plus a JSON summary of recorded (simulated) measurements.
# No images, video or personal data. Calls are billed to your Meta account (see Settings > budget).
# CROWDGUARD_PROVIDER=meta
# META_MODEL_API_KEY=<paste your own key here, in .env only>
# META_MODEL=muse-spark-1.3

# --- Optional: count people with Meta SAM 3.1 (see docs/camera-wall.md) ---------------------------
# Off by default. Uses the SAME Meta key as above (META_MODEL_API_KEY). When on, camera frames showing
# people are sent to Meta and billed per image (about $0.0025). A spend cap applies (default $1).
# CROWDGUARD_DETECTOR=sam31
# SAM_THRESHOLD=0.5        # minimum confidence for a person box
# CROWDGUARD_GALLERY=gallery   # folder holding the .mp4 files offered in the Camera wall dropdowns

# --- Optional: AI Assistant (text Q&A and voice input) ------------------------------------------------
# The assistant uses Muse Spark with tool calling, so it needs CROWDGUARD_PROVIDER=meta + META_MODEL_API_KEY above.
# Voice is a separate opt-in because the recording leaves this computer and is billed by audio length.
# CROWDGUARD_VOICE=meta                 # enables Muse Voice Transcribe (muse-voice-transcribe-1.0)
# META_VOICE_API_KEY=<optional, in .env only; defaults to META_MODEL_API_KEY>
# META_VOICE_MODE=ENDPOINTING           # or PUSH_TO_TALK

# Future (not used yet):
# AWS_REGION=eu-west-1
